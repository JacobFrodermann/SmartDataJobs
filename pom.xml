<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.smartdata</groupId>
    <artifactId>SmartDataJobs</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>SmartDataJobs</name>
    <description>REST API for controlling and executing recurring jobs.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!--
        The Smart* helper libraries (NGI_Logger, NGI_RestUtils,
        NGI_AdvancedReflection and SmartUserAuth) are not published to Maven
        Central. They are kept in a small file based Maven repository inside
        this project so the build is self contained.
    -->
    <repositories>
        <repository>
            <id>smartdata-local</id>
            <url>file://${project.basedir}/libs/maven-repo</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Provided by the Jakarta EE application server (Payara). -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Smart* helper libraries. -->
        <dependency>
            <groupId>de.fhbielefeld.scl</groupId>
            <artifactId>NGI_Logger</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>de.fhbielefeld.scl</groupId>
            <artifactId>NGI_RestUtils</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>de.fhbielefeld.scl</groupId>
            <artifactId>NGI_AdvancedReflection</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>de.fhbielefeld.smartuser</groupId>
            <artifactId>SmartUserAuth</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Third party libraries packaged into the WAR. -->
        <dependency>
            <groupId>org.eclipse.microprofile.openapi</groupId>
            <artifactId>microprofile-openapi-api</artifactId>
            <version>3.1</version>
        </dependency>
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
            <version>3.11.1</version>
        </dependency>
        <dependency>
            <groupId>com.javadocmd</groupId>
            <artifactId>simplelatlng</artifactId>
            <version>1.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
            <version>0.10.2</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>SmartDataJobs</finalName>

        <!--
            The NetBeans/Ant layout is kept: the Java sources and the resource
            files next to them live in src/java, the document root in web/.
        -->
        <sourceDirectory>src/java</sourceDirectory>

        <!--
            NetBeans copied the non-Java files from src/java into
            WEB-INF/classes (hibernate.properties). Maven needs this declared
            explicitly.
        -->
        <resources>
            <resource>
                <directory>src/java</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <warSourceDirectory>web</warSourceDirectory>
                    <!-- The application uses Servlet 3+ annotations, no web.xml is required. -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
